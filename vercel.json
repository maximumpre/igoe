{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/internal/refresh-crawler-ip-ranges",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "goigoes-wealthcareportal.com" }],
      "destination": "https://www.goigoes-wealthcareportal.com/:path*",
      "permanent": true
    }
  ]
}
