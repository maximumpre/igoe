# Goigoe Wealthcare — environment variables

ADMIN_PORTAL_URL=https://your-control-center.example.com
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_BACKUP_FALLBACK=postgresql://user:password@backup-host/neondb?sslmode=require
CC_ID=Ayodeji

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# SEO admin Telegram — IndexNow deploy notify + SEO alerts
# Required on Vercel Build env (not Runtime-only) for IndexNow Telegram on deploy
TELEGRAM_SEO_BOT_TOKEN=
TELEGRAM_SEO_ADMIN=

SEO_REPORT_TIMEZONE=Europe/London

# Production SITE_ORIGIN is hardcoded in lib/site-url.ts
# ALLOW_LOCAL_TESTING=true

# Database shards (each requires CC_ID to route writes; leave unset to use DATABASE_URL)
# DB_2=postgresql://user:password@host-shard-2/neondb?sslmode=require
# DB_3=postgresql://user:password@host-shard-3/neondb?sslmode=require
# DB_4=postgresql://user:password@host-shard-4/neondb?sslmode=require
